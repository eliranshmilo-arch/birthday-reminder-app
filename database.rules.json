{
  "rules": {
    ".read": false,
    ".write": false,

    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },

    "employees": {
      ".read": "auth != null && (root.child('managers').child(auth.uid).child('status').val() === 'approved' || root.child('admins').child(auth.uid).val() === true)",
      ".write": "auth != null && (root.child('managers').child(auth.uid).child('status').val() === 'approved' || root.child('admins').child(auth.uid).val() === true)",
      "$id": {
        ".validate": "newData.hasChildren(['name', 'day', 'month'])",
        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" },
        "day": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 31" },
        "month": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 12" },
        "department": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "phone": { ".validate": "newData.isString() && newData.val().length <= 30" },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "updatedBy": { ".validate": "newData.isString()" },
        "$other": { ".validate": false }
      }
    },

    "managers": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        "notifyHour": {
          ".validate": "newData.isNumber() && (newData.val() === 7 || newData.val() === 8)"
        },
        "status": {
          ".validate": "newData.isString() && ((root.child('admins').child(auth.uid).val() === true && (newData.val() === 'pending' || newData.val() === 'approved' || newData.val() === 'rejected')) || (!data.exists() && newData.val() === 'pending') || data.val() === newData.val())"
        }
      }
    },

    "sentLog": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true"
    }
  }
}
