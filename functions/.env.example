# העתק את הקובץ הזה לקובץ בשם .env (באותה תיקייה) ומלא את הערכים.
# הקובץ .env לא עולה לגיטהאב.

# הכתובת של האפליקציה ב-GitHub Pages (עם / בסוף)
APP_URL=https://eliranshmilo-arch.github.io/birthday-reminder-app/

# ---- וואטסאפ (אופציונלי – להשאיר ריק עד שמגדירים חשבון Meta) ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=birthday_reminder
WHATSAPP_LANG=he
WHATSAPP_API_VERSION=v21.0
